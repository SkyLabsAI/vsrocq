(executable
 (name vsrocqtop)
 (public_name vsrocqtop)
 (flags -linkall)
 (package vsrocq-language-server)
 (preprocess (pps ppx_optcomp -- -cookie "ppx_optcomp.env=env ~rocq:(Defined \"%{rocq:version}\")"))
 (preprocessor_deps vsrocq_config.mlh)
 (libraries rocq-runtime.sysinit rocq-runtime.tactics sel yojson dm lsp))

(rule
 (target vsrocq_config.mlh)
 (mode (promote (only vsrocq_config.mlh)))
 (action (with-stdout-to %{target}
   (progn
     (echo "(* Automatically generated, don't edit *)\n")
     (echo "[%%define lsp ")
     (run vsrocq_version_parser %{version:lsp})
     (echo "]\n")))))
